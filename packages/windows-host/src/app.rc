#include <windows.h>
IDI_ICON1 ICON "assets/orbis.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION ORBIS_VERSION_NUMERIC
 PRODUCTVERSION ORBIS_VERSION_NUMERIC
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "Orbis"
   VALUE "FileDescription", "Orbis Host"
   VALUE "FileVersion", ORBIS_VERSION
   VALUE "ProductName", "Orbis Host"
   VALUE "ProductVersion", ORBIS_VERSION
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
